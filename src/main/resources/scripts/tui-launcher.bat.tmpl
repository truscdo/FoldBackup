@echo off
setlocal DisableDelayedExpansion
set "ROOT=%~dp0."
set "MODS_DIR={{MODS_DIR}}"
set "JAR="
for /f "delims=" %%f in ('dir /b /a-d /o-n "%~dp0foldbackup-*.jar" 2^>nul') do set "JAR=%~dp0%%f"
if defined JAR goto :found
set "JAR=%~dp0foldbackup.jar"
if exist "%JAR%" if not exist "%JAR%\" goto :found
set "JAR="
for /f "delims=" %%f in ('dir /b /a-d /o-n "%MODS_DIR%\foldbackup-*.jar" 2^>nul') do set "JAR=%MODS_DIR%\%%f"
:found
if not defined JAR (
    echo Error: foldbackup jar not found next to the script or in the configured mods directory.
    pause
    exit /b 1
)
java -jar "%JAR%" extract --output "%~dp0.foldbackup-cli"
if errorlevel 1 (
    echo Error: failed to export bundled libraries ^(read-only backup root?^).
    pause
    exit /b 1
)
java -jar "%JAR%" tui --snapshot-root "%ROOT%" --archive-root "%ROOT%" --lib "%~dp0.foldbackup-cli"
set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" pause
exit /b %RESULT%
